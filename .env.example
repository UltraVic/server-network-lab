# 설정/시크릿 분리 (Phase 7) — 이 파일은 "템플릿"이라 커밋한다.
# 실제 값은 .env 에 넣고, .env 는 절대 커밋하지 않는다 (.gitignore 등록됨).
# 협업자는 이 파일을 복사해 .env 를 만든다:  cp .env.example .env
#
# 우선순위: OS 환경변수 > .env > 코드 기본값

# ── Postgres (db 서비스) ──
POSTGRES_USER=lab
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=lab

# ── 백엔드 ──
# JWT 서명 비밀키 — 최소 32자 이상의 무작위 문자열. 새면 토큰 위조 가능.
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
# DB 커넥션 풀 크기 (Phase 5 실험: 1 vs 10)
POOL_SIZE=10

# ── Phase 1 실습용 (프록시 뒤에선 불필요) ──
# ALLOW_CORS=1
